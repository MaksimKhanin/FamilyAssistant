# Скопируйте в edge/cameras.yml и заполните. Файл не коммитится — в нём пароли от камер.
#   cp edge/cameras.yml.example edge/cameras.yml

server:
  # Адрес сервера FamilyAssistant. Наружу светить не обязательно: достаточно
  # приватного туннеля (Tailscale/WireGuard) или SSH reverse tunnel.
  url: "https://assistant.example.com"
  # Тот же ключ, что INGEST_API_KEY в .env сервера.
  api_key: "REPLACE_WITH_INGEST_API_KEY"
  # Нужен, только если на сервере заведено больше одной семьи.
  family_id: 0

detector:
  # yolov8n — самая лёгкая, хватает для «есть человек / нет человека».
  # Тяжелее (yolov8m, yolov9) — точнее, но нужен GPU или мощный CPU.
  model: "yolov8n.pt"
  confidence: 0.35
  # Обрабатывать каждый N-й кадр: 3 при 15 fps — это ~5 проверок в секунду.
  sample_every: 3

cameras:
  gate:
    # Обычно sub-stream: он мельче и дешевле для детекции.
    url: "rtsp://USER:PASSWORD@192.168.0.24:554/h264/ch01/sub/av_stream"
    motion_threshold: 3000
    min_area: 500
    cooldown_sec: 45
  yard:
    url: "rtsp://USER:PASSWORD@192.168.0.25:554/h264/ch01/sub/av_stream"
    motion_threshold: 3000
    min_area: 500
    cooldown_sec: 45
