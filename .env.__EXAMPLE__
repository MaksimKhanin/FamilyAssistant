# Скопируйте в .env (файл не коммитится) и заполните.
#   cp .env.__EXAMPLE__ .env
# Случайную строку удобно получить так:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- администратор --------------------------------------------------------

# Первый вход в панель. Создаётся при первом старте на пустой базе; дальше все
# учётные записи глава семьи заводит сам в панели, а этот пароль больше не
# применяется — сменить его можно только через ADMIN_PASSWORD_RESET ниже.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_REAL_PASSWORD
ADMIN_NAME=Марина
ADMIN_RELATION=мама
FAMILY_NAME=Наша семья

# Аварийный сброс пароля главы семьи к значению выше. Включить, перезапустить,
# войти — и сразу выключить обратно.
ADMIN_PASSWORD_RESET=false

# --- обязательное ---------------------------------------------------------

# Пароль пользователя family в Postgres
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LONG_STRING

# Подпись сессионных cookie. Должна быть стабильной между рестартами,
# иначе все выйдут из панели при каждом деплое.
SESSION_SECRET=REPLACE_WITH_RANDOM_LONG_STRING

# Ключ, которым домашний рекордер аутентифицируется при отправке файлов с камер.
# Тот же самый нужно положить рекордеру в cfg/cfg.local.yml → archive_sync.api_key
# (или в переменную ARCHIVE_API_KEY на его стороне).
INGEST_API_KEY=REPLACE_WITH_RANDOM_LONG_STRING

# --- пульт рекордера (необязательно) --------------------------------------

# Адрес control-API рекордера: с ним панель умеет включать тревогу, заказывать
# снимок и запись прямо с карточки камеры. Без него кнопки просто не показываются.
# Адрес должен быть приватным — Tailscale, WireGuard или домашняя сеть, но не
# публичный интернет: за этой дверью управление домом.
CONTROL_BASE_URL=
# Тот же токен, что в cfg/cfg.local.yml рекордера → control.token
CONTROL_API_TOKEN=

# --- модель ---------------------------------------------------------------

# Любой OpenAI-совместимый эндпоинт: OpenAI, Ollama, vLLM, LM Studio.
#   OpenAI:  https://api.openai.com/v1
#   Ollama:  http://host.docker.internal:11434/v1   (LLM_API_KEY можно оставить пустым)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Отдельная модель для фото блюд. Пусто — используется та же, что LLM_MODEL
# (это соответствует выбору «То же ядро» на экране «Модель и знания»).
LLM_VISION_MODEL=

# Режим размышления модели: off / low / medium / high, либо пусто — не вмешиваться.
# По умолчанию off: ассистент выбирает инструмент и отвечает парой фраз, и
# «думающая» модель добавляет к каждому ответу секунды на ровном месте.
# Ставьте medium/high, только если чат стал заметно глупее.
# При off клиент сам глушит «размышления» reasoning-моделей (Qwen3 и похожих) —
# отдельной переменной для этого не нужно.
LLM_REASONING=off

# То же самое, но отдельно для оценочных вызовов: КБЖУ по фото и по описанию,
# разбор события с камеры. Тоже off: на Qwen3 через OpenRouter размышление давало
# те же цифры вчетверо дороже, а на коротком бюджете модель успевала только подумать
# и не дописывала ответ. Ставьте low, только если ваша модель думает дёшево.
LLM_REASONING_ESTIMATE=off

# И отдельно — подбор идей питания. Здесь, в отличие от чата и оценок, размышление
# по умолчанию включено: это единственная задача, где ответ надо собрать (уложиться
# в норму, свести цель, обойти запрет, не повторить вчерашнее), а не вспомнить.
# Ставьте low или off, если модель дома медленная: идеи соберутся и без мыслей.
# Экран идей ждёт около минуты — думающему вызову клиент сам отпускает больше
# времени, чем LLM_TIMEOUT (иначе ответ обрывается ровно на финише).
LLM_REASONING_PLAN=medium

# Запасной ход для нестандартных провайдеров: любые поля запроса, JSON-объектом.
# Перекрывает пресет выше. Примеры:
#   {"reasoning": {"max_tokens": 0}}
#   {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=

# --- озвучка ответов (необязательно) --------------------------------------

# Панель умеет читать ответы вслух, и по умолчанию делает это голосом самого
# устройства: браузер синтезирует речь сам, бесплатно и не выпуская текст из
# дома. Ключи для этого не нужны — переменные ниже нужны только для живого
# голоса, который считает модель.
#
# Пока SPEECH_MODEL пуст, вариант «Модель озвучки» на экране «Модель и знания»
# помечен как недоступный, и панель читает устройством, даже если он выбран.
# Адрес и ключ по умолчанию берутся у LLM_BASE_URL / LLM_API_KEY: чаще всего
# это тот же провайдер.
#
#   OpenAI:  SPEECH_MODEL=gpt-4o-mini-tts (или tts-1)
#   Своё:    любой сервер с OpenAI-совместимым /audio/speech
SPEECH_MODEL=
SPEECH_BASE_URL=
SPEECH_API_KEY=
# Формат звука: mp3 играет везде, включая iPhone. Меняйте, только если провайдер
# отдаёт что-то другое: opus, aac, flac, wav, pcm.
SPEECH_FORMAT=mp3
SPEECH_TIMEOUT=30

# --- поиск в интернете (необязательно) ------------------------------------

# Нужен ровно для одного: у фабричной еды состав опубликован, и списать его
# честнее, чем прикинуть на глаз. «Батончик Марс», «пицца пепперони из Додо»,
# банка колы — ассистент найдёт этикетку и посчитает по ней, а домашний борщ
# как считал на глаз, так и считает.
#
# Пусто — наружу ассистент не ходит вовсе, и всё продолжает работать: еда
# записывается обычной оценкой.
#
#   tavily   — WEB_SEARCH_API_KEY от tavily.com
#   brave    — WEB_SEARCH_API_KEY от Brave Search API
#   searxng  — свой SearXNG: WEB_SEARCH_BASE_URL=http://searxng:8080, ключ не нужен
#              (в его settings.yml должен быть включён формат json)
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_LANG=ru

# --- уведомления на телефоны (web push) -----------------------------------

# Сгенерировать один раз:  python -m scripts.vapid_keys
# Менять потом нельзя: все подписки устройств станут недействительными и семье
# придётся заново разрешать уведомления.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:вашапочта@example.com

# Адрес, по которому панель доступна снаружи: подставляется в ссылки-приглашения
# и в уведомления. Для push обязателен HTTPS — иначе браузер не даст подписаться.
PUBLIC_BASE_URL=http://localhost:5000

# --- Telegram (необязательно) ---------------------------------------------

# Дополнительный канал, по умолчанию выключен: docker compose --profile telegram up -d
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=

# --- прочее ---------------------------------------------------------------

# true — только за HTTPS-прокси. По простому HTTP браузер молча выбросит
# Secure-куку, и вход будет «проваливаться» без ошибки.
COOKIE_SECURE=false

WEB_PORT=5000
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Сколько дней хранить записи камеры, у которой срок не задан отдельно.
# У каждой камеры он свой (Camera.retention_days), это — общий запасной.
MEDIA_RETENTION_DAYS=14

# Куда складывать кадры и видео. В Docker это том `media`, менять не нужно;
# для локального запуска — обычный каталог рядом с проектом.
# MEDIA_ROOT=./media

# Шина событий между процессами. Пусто — всё работает в одном процессе,
# и это нормально для одной семьи; Redis нужен, когда подняты web + scheduler + bot.
# REDIS_URL=redis://redis:6379/0

# Какие модули собирать. Убрать лишний — значит убрать его экраны, таблицы
# и инструменты агента целиком.
# ENABLED_MODULES=nutrition,security,memory

# --- стенд (только для проверок) ------------------------------------------

# Ключ служебных ручек `/api/testkit`, которыми сценарии проходят панель снаружи
# (docs/testkit.md). Пусто — стенда нет вовсе: ни роутов, ни журнала запросов,
# ни подмены модели. Ключ короче 20 знаков не принимается.
#
# В бою держать пустым: `reset` сносит базу целиком, `login` пускает без пароля,
# а ходят эти ручки мимо входа и мимо ролей.
# TESTKIT_TOKEN=
