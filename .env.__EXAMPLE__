# Скопируйте в .env (файл не коммитится) и заполните.
#   cp .env.__EXAMPLE__ .env
# Случайную строку удобно получить так:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- обязательное ---------------------------------------------------------

# Пароль пользователя family в Postgres
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LONG_STRING

# Подпись сессионных cookie. Должна быть стабильной между рестартами,
# иначе все выйдут из панели при каждом деплое.
SESSION_SECRET=REPLACE_WITH_RANDOM_LONG_STRING

# Ключ, которым домашний edge-воркер аутентифицируется при отправке событий с камер.
# Тот же самый нужно положить в edge/cameras.yml.
INGEST_API_KEY=REPLACE_WITH_RANDOM_LONG_STRING

# --- модель ---------------------------------------------------------------

# Любой OpenAI-совместимый эндпоинт: OpenAI, Ollama, vLLM, LM Studio.
#   OpenAI:  https://api.openai.com/v1
#   Ollama:  http://host.docker.internal:11434/v1   (LLM_API_KEY можно оставить пустым)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Отдельная модель для фото блюд. Пусто — используется та же, что LLM_MODEL
# (это соответствует выбору «То же ядро» на экране «Модель и знания»).
LLM_VISION_MODEL=

# --- уведомления на телефоны (web push) -----------------------------------

# Сгенерировать один раз:  python -m scripts.vapid_keys
# Менять потом нельзя: все подписки устройств станут недействительными и семье
# придётся заново разрешать уведомления.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:вашапочта@example.com

# Адрес, по которому панель доступна снаружи: подставляется в ссылки-приглашения
# и в уведомления. Для push обязателен HTTPS — иначе браузер не даст подписаться.
PUBLIC_BASE_URL=http://localhost:5000

# --- Telegram (необязательно) ---------------------------------------------

# Дополнительный канал, по умолчанию выключен: docker compose --profile telegram up -d
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=

# --- прочее ---------------------------------------------------------------

# true — только за HTTPS-прокси. По простому HTTP браузер молча выбросит
# Secure-куку, и вход будет «проваливаться» без ошибки.
COOKIE_SECURE=false

WEB_PORT=5000
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
